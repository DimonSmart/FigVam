<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Illustrative WPF mapping of FigVam effective resources (Light theme). -->
  <!-- A theme adapter replaces this dictionary atomically when the theme changes. -->
  <Color x:Key="BrandColor">#FF3355AA</Color>
  <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
  <sys:Double x:Key="BodyFontSize">18</sys:Double>
  <FontFamily x:Key="BodyFontFamily">Segoe UI</FontFamily>
  <FontWeight x:Key="BodyFontWeight">Normal</FontWeight>
  <sys:Double x:Key="BorderWidth">1</sys:Double>

  <Style x:Key="BaseTextStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource BodyFontWeight}" />
  </Style>
  <Style x:Key="TitleTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BaseTextStyle}">
    <Setter Property="FontSize" Value="24" />
  </Style>
  <Style x:Key="BorderPanelStyle" TargetType="{x:Type Border}">
    <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderWidth}" />
  </Style>
</ResourceDictionary>
