<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\FigVam.Application\FigVam.Application.csproj" />
    <ProjectReference Include="..\FigVam.Infrastructure\FigVam.Infrastructure.csproj" />
    <ProjectReference Include="..\FigVam.ServiceDefaults\FigVam.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>figvam-server-google-auth</UserSecretsId>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <FigVamWebRoot>$(MSBuildThisFileDirectory)../FigVam.Web/</FigVamWebRoot>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(FigVamWebRoot)dist/auth-client.js;$(FigVamWebRoot)dist/api-client.js;$(FigVamWebRoot)dist/decode.js;$(FigVamWebRoot)dist/session.js;$(FigVamWebRoot)dist/home-ui.js;$(FigVamWebRoot)dist/token-resolution.js;$(FigVamWebRoot)dist/token-groups.js;$(FigVamWebRoot)dist/token-exchange.js;$(FigVamWebRoot)dist/canvas-viewport.js;$(FigVamWebRoot)dist/layer-drag.js;$(FigVamWebRoot)dist/canvas-node-editor.js;$(FigVamWebRoot)dist/screen-resize.js;$(FigVamWebRoot)dist/screen-renderer.js;$(FigVamWebRoot)dist/visual-screen.js;$(FigVamWebRoot)dist/render-model.js;$(FigVamWebRoot)dist/screen-capture.js;$(FigVamWebRoot)dist/headless-preview.js;$(FigVamWebRoot)dist/document-collaboration.js;$(FigVamWebRoot)dist/document-export.js;$(FigVamWebRoot)dist/node-property-controls.js;$(FigVamWebRoot)dist/token-value-control.js;$(FigVamWebRoot)dist/padding-editor.js;$(FigVamWebRoot)dist/layer-caption.js;$(FigVamWebRoot)dist/scenarios.js;$(FigVamWebRoot)dist/interaction-editor.js;$(FigVamWebRoot)dist/interaction-catalog.js"
             Link="wwwroot/%(Filename)%(Extension)"
             TargetPath="wwwroot/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RestoreFigVamFrontend"
          Inputs="$(FigVamWebRoot)package.json;$(FigVamWebRoot)package-lock.json"
          Outputs="$(FigVamWebRoot)node_modules/.package-lock.json">
    <Exec WorkingDirectory="$(FigVamWebRoot)" Command="npm ci" />
  </Target>

  <Target Name="BuildFigVamFrontend" BeforeTargets="PrepareForBuild"
          DependsOnTargets="RestoreFigVamFrontend" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(FigVamWebRoot)" Command="npm run build" />
  </Target>

</Project>
